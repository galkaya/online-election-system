        <mxCell id="s0" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="DRAFT" value="DRAFT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="160" y="60" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="OPEN" value="OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="150" height="60" as="geometry"/>
