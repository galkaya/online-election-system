        <mxCell id="n_privacy" value="Ballot has no association to UserAccount or Participation&lt;br/&gt;and no timestamp. It stores only the SHA-256 hash of the&lt;br/&gt;confirmation code. Participation stores who voted, never&lt;br/&gt;for whom. Unique (electionId, voterId) is the one-vote rule." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#fff8dc;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="430" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n_audit" value="AuditEvent never stores a candidate,&lt;br/&gt;a ballot id or a confirmation code.&lt;br/&gt;Accepted votes create no AuditEvent." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#fff8dc;" vertex="1" parent="1">
